# Supabase Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# LOCAL DEVELOPMENT (using local Supabase)
# ==========================================
# Use these values when running `supabase start` locally
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ==========================================
# PRODUCTION (using hosted Supabase)
# ==========================================
# Uncomment and replace with your production values from https://supabase.com/dashboard
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# STAGING (optional)
# ==========================================
# EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. For local development: Keep the values above and run `supabase start`
# 2. For production: 
#    - Create a new project at https://supabase.com/dashboard
#    - Replace the URLs with your production values
#    - Run migrations: `supabase db push`
#    - Deploy your app with the production values